                                        <img src="~/Content/Images/Logos/MOC.png" alt="MOC Fuel Assistance Program" border="0" />
                                    </a>
                                </div>
                                <div class="large-9 columns" style="text-align: center;">
                                    <p class="small">We are a participating member of the <b class="blue">MOC Fuel Assistance Program.</b> <br /> <a href="https://www.mocinc.org/fuelassistance" target="_blank">Sign up today!</a></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="large-12 columns">
                        <div class="panel radius" style="margin:40px;">
                            <h2>Proudly Serving the Following Communities</h2>
                            <div class="flow">
                                <ul>
                                    @foreach (string town in Model.ServiceAreas.Distinct())
                                    {
                                        <li><b class="blue small">@town</b></li>
                                    }
                                </ul>
                            </div>
                            <br />
                        </div>
                        @Html.Partial("_Footer")
                    </div>
                </div>
            </div>
    </div>
</div>
@section scripts {
    <script type="text/javascript">
        $(function () {
            $('#newCustomerHref').on('click', function (event) {
                event.preventDefault();
                $('#newCustomerModal').foundation('reveal', 'open');
            });
            $('#dropletfuel').on('click', function (event) {
                event.preventDefault();
                $('#newCustomerModal').foundation('reveal', 'open');
            });
            $('#dropletfuel-account').on('click', function (event) {
                event.preventDefault();
                window.open($('#myAccountHref').attr('href'));
            });
            $('#newCustomerModal button').on('click', function () {
                $('#newCustomerModal').foundation('reveal', 'close');
                window.open($('#newCustomerHref').attr('href'));
            });
            if ($('#alertModal').length) {
                var alertIndex = 1;
                modal = $('#alertModal')
                modal.foundation('reveal', 'open');
                $('#prevAlert', modal).on('click', function () {
                    if ($('#alert-' + (alertIndex - 1)).length) {
                        $('#alert-' + alertIndex).hide();
                        alertIndex--;
                        $('#alert-' + alertIndex).show();
                    }
                });
                $('#nextAlert', modal).on('click', function () {
                    if ($('#alert-' + (alertIndex + 1)).length) {
                        $('#alert-' + alertIndex).hide();
                        alertIndex++;
                        $('#alert-' + alertIndex).show();
                    }
                });
                $('#prevAlert', modal).trigger('click');
            }
        });
    </script>
}